meta {
  name: Signout
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/auth/signout
  body: formUrlEncoded
  auth: none
}

headers {
  Content-Type: application/x-www-form-urlencoded
}

body:form-urlencoded {
  csrfToken: {{csrfToken}}
  json: true
}

assert {
  res.status: in [200, 302]
}

docs {
  ## POST /api/auth/signout

  session cookie を破棄してログアウト。事前に CSRF token が必要。
}
